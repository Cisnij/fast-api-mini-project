ORM của sync:
instance = Tên bảng muốn lấy
        db.query(instance).all() : lấy tất cả bản ghi của bảng
        db.query(instance).first() | db.query(instance).filter(instance.id == 1).first() : lấy bản ghi đầu tiên của bảng
        db.query(instance).filter(instance.id == 1).all() : lấy bản ghi của bảng theo điều kiện
        db.query(instance).get(id=1)
        db.query(instance).order_by(instance.id.desc()): sắp theo thứ tự id
        db.query(instance).count()
        db.add(instance) and db.commit()
        db.delete(instance) and db.commit()
        db.query(instance).filter(instance.published == True).delete(): xóa hàng loạt theo điều kiện
        db.query(instance).filter(instance.age >= 18, instance.age <= 30).all() : filter theo nhiều điều kiện
                                                                        .exists() : kiểm tra có bản ghi tồn tại theo điều kiện 
        db.query(Todo).filter(Todo.id == id).update({"title": "Tiêu đề mới"}) : update bulk
        todos = db.query(Todo).options(joinedload(Todo.owner)).all()   # JOIN sẵn, chỉ 1 query
có 2 cách xóa 1 là "db.delete(instance)", 2 là xóa trên câu query cho bulk delete "db.query(Todo).filter(Todo.is_completed == True).delete(synchronize_session=False)"

ORM của async:

    (await db.execute(select(Todo))).scalars().all()
    → lấy tất cả Todo

    (await db.execute(select(Todo).filter(Todo.age >= 18))).scalars().all()
    → lấy tất cả Todo có age >= 18

    (await db.execute(select(Todo))).scalars().first()
    → lấy Todo đầu tiên

    (await db.execute(select(Todo).filter(Todo.age >= 18))).scalars().first()
    → lấy Todo đầu tiên có age >= 18

    await db.get(Todo, 1)
    → lấy Todo có ID = 1

    (await db.execute(select(Todo).order_by(Todo.id.desc()))).scalars().all()
    → lấy tất cả Todo, sắp xếp ID giảm dần

    (await db.execute(select(func.count()).select_from(Todo))).scalar()
    hoặc select(func.count()).select_from(Model).where(condition).scalar()
    → đếm số Todo

    await db.execute(update(Todo).filter(Todo.id == 1).values(title="New"))
    → update Todo có ID = 1

    select(Todo).where((Todo.age >= 18) & (Todo.age <= 30))  # AND
    select(Todo).where((Todo.age >= 18) | (Todo.age <= 10))  # OR
    select(Todo).where(((Todo.age >= 18) | (Todo.age <= 10)) & (Todo.published == True))  # (A OR B) AND C

    await db.execute(delete(Todo).filter(Todo.id == 1))
    → xóa Todo có ID = 1

    db.add(todo)
    await db.commit()
    → thêm Todo

    await db.delete(todo)
    await db.commit()
    → xóa Todo


