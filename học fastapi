Cấu trúc mẫu
from pydantic import BaseModel, ConfigDict
from typing import Optional

# todo/models.py
class TodoCreate(BaseModel):
    title: str
    description: Optional[str] = None

# todo/schemas.py
class TodoCreate(BaseModel):
    title: str
    description: Optional[str] = None

# todo/service.py
def create_todo(db: Session, data: TodoCreate, owner_id: int = Depends(get_current_user_id)) -> Todo: #hoặc list[Todo]
    todo = Todo(title=data.title, description=data.description, owner_id=owner_id)
    db.add(todo)
    db.commit()
    db.refresh(todo)
    return todo

# todo/router: gọi lại services kiểu views.py gọi service bên djrf
@router.post("/", response_model=TodoResponse)
def create_todo(data: TodoCreate, db: Session = Depends(get_db)):
    return service.create_todo(db, data, owner_id=1)

# todo/exceptions.py : raise lỗi gì
class TodoPermissionDenied(HTTPException):
    def __init__(self):
        super().__init__( # khi gọi tới hàm này thì gọi constructor của TodoPermissionDenied, sau đó super lại gọi constructor(init) từ class Cha là HTTPException
            status_code=status.HTTP_403_FORBIDDEN,
            detail="Bạn không có quyền thao tác trên todo này"
        )

# todo/selectors.py
def get_todo(db: Session, todo_id: int) -> Todo:
    todo = db.query(Todo).filter(Todo.id == todo_id).first()
    if not todo:
        raise TodoNotFound(todo_id)
    return todo

# todo/dependencies.py : dùng như permission xem ai có quyền, check quyền là chính
def verify_todo_owner(todo_id: int, db: Session = Depends(get_db), current_user_id: int = Depends(get_current_user_id)) -> Todo:
    todo = get_todo(db, todo_id)
    if todo.owner_id != current_user_id:
        raise TodoPermissionDenied()
    return todo
def get_current_user_id(token: str = Depends(oauth2_scheme)) -> int:
    user_id = decode_jwt(token)
    if not user_id:
        raise HTTPException(401, "Chưa đăng nhập")
    return

dependencies sẽ check cái này có quyền gì, ai có quyền gì và raise lỗi exception, check quyền trước khi thực thi hàm luôn thuộc về permission
services.py thì check bussiness logic và raise exception. Exeption chỉ là nơi chứa mã lỗi và detail
bussiness logic là những thứ chung cho toàn hệ thống, còn riêng là thuộc permission, ví dụ user A có thể kết bạn với 1200 người mà user B chỉ có thể 1000

transaction: with db.begin():
db.flush(): dùng để có được dữ liệu cần có mà chưa cần commit. Bên django chỉ cần create là có data khac với sqlalchemy cần phải add vào bộ nhớ rồi gửi xuống db
    ví dụ:
    def create_todo_with_log(db: Session, data: TodoCreate, user_id: int):
        todo = Todo(title=data.title, user_id=user_id)
        db.add(todo)
        db.flush()   # ÉP SQLAlchemy chạy INSERT ngay, todo.id GIỜ ĐÃ CÓ (ví dụ 7)
        log = ActivityLog(todo_id=todo.id, action="created")   # todo.id = 7, ĐÚNG
        db.add(log)
        db.commit()   # chốt CẢ HAI cùng lúc: todo và log

        # autoflush=True : SQLAlchemy TỰ ĐỘNG gọi flush() TRƯỚC dòng query()